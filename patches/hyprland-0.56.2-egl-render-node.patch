+#ifndef EGL_DRM_RENDER_NODE_FILE_EXT
+#define EGL_DRM_RENDER_NODE_FILE_EXT 0x3377
+#endif
+
+std::optional<std::string> CHyprOpenGLImpl::eglDeviceRenderNode() {
+    if (!m_eglDevice || !m_proc.eglQueryDeviceStringEXT)
+        return std::nullopt;
+
+    const char* node = m_proc.eglQueryDeviceStringEXT(m_eglDevice, EGL_DRM_RENDER_NODE_FILE_EXT);
+    if (!node || !*node)
+        return std::nullopt;
+
+    return std::string{node};
+}
