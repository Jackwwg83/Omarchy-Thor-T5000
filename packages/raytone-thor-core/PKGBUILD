# RaytoneOS: NVIDIA L4T R39.2.1 base userspace for Jetson AGX Thor: core libraries, init scripts and
# units, power model, fan control, tools, NVML (nvidia-smi) and NvSci.
pkgname=raytone-thor-core
pkgver=39.2.1
pkgrel=3
pkgdesc='NVIDIA L4T R39.2.1 base userspace, power and fan control for Jetson AGX Thor'
arch=(aarch64)
url='https://developer.nvidia.com/embedded/jetson-linux'
license=(LicenseRef-NVIDIA-L4T)
depends=(bash raytone-thor-linux raytone-thor-firmware)
install=raytone-thor-core.install
options=(!strip !debug)
backup=(etc/nvpmodel/nvpmodel_p3834_0008.conf etc/nvpower/nvfancontrol/nvfancontrol_p3834_0008_p4071_0000.conf)

# BEGIN l4t sources
