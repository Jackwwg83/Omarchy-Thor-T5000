noextract=(nvidia-l4t-core.deb nvidia-l4t-init.deb nvidia-l4t-init-openrm.deb nvidia-l4t-configs.deb nvidia-l4t-nvpmodel.deb nvidia-l4t-nvfancontrol.deb nvidia-l4t-tools.deb nvidia-l4t-nvml.deb nvidia-l4t-nvsci.deb)
