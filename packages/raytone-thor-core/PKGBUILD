source+=(l4t_repack.py l4t_manifest.py)
sha256sums+=(SKIP SKIP)
# Only NVIDIA-named libraries enter the loader path, through /usr/lib/raytone-l4t; NVIDIA's own
# ld.so.conf.d entry for the whole directory is dropped, so nothing there can shadow Arch's libraries.
_allow='^(libnv|libcuda|libGLX_nvidia|libEGL_nvidia|libGLES(v1_CM|v2)_nvidia|libtegra|libjetsonpower)'

_stage() { # unpack each deb's data.tar into its own tree
  local d
  for d in "${_l4t_debs[@]}"; do
    rm -rf "$srcdir/stage-$d" && mkdir -p "$srcdir/stage-$d"
    bsdtar -xOf "$srcdir/$d.deb" 'data.tar.*' | bsdtar -xpf - -C "$srcdir/stage-$d"
  done
}

_repack() { # _repack EXCLUDE_REGEX... : lay the trees out for Arch, report kept and dropped paths
  local args=() rx
  for rx in "$@"; do args+=(--exclude "$rx"); done
  python3 "$srcdir/l4t_repack.py" --out "$pkgdir" --pkgname "$pkgname" --report "$srcdir/$pkgname-report.json" \
    "${args[@]}" $(printf "$srcdir/stage-%s " "${_l4t_debs[@]}")
  install -Dm644 "$srcdir/$pkgname-report.json" "$pkgdir/usr/share/raytone/$pkgname-report.json"
}

package() {
  _stage
  _repack '^/etc/ld\.so\.conf\.d/' '^/etc/(cloud|skel|apt|xdg)/' '^/usr/share/applications/' \
          '^/etc/systemd/system-preset/' '^/etc/modprobe\.d/nvgpu\.conf$' '/nv-(depmod|modprobe)-nvgpu' \
          '/nv_fuse_read|/nv_overlayfs_config|/nv-update-debian-release|/nvimp_util'
  local f
  install -d "$pkgdir/usr/lib/raytone-l4t"
  for f in "$pkgdir"/usr/lib/aarch64-linux-gnu/nvidia/*.so*; do
    if [[ $(basename "$f") =~ $_allow ]]; then
      ln -s "/usr/lib/aarch64-linux-gnu/nvidia/$(basename "$f")" "$pkgdir/usr/lib/raytone-l4t/"
    fi
  done
  install -d "$pkgdir/etc/ld.so.conf.d" "$pkgdir/usr/lib/sysusers.d"
  echo /usr/lib/raytone-l4t > "$pkgdir/etc/ld.so.conf.d/raytone-l4t.conf"
  # Groups NVIDIA's init package creates on Ubuntu, used by its udev rules. debug owns the GPU
  # debugger and profiler nodes (nvhost-dbg-gpu, nvhost-prof-*): no user is added to it.
  cat > "$pkgdir/usr/lib/sysusers.d/raytone-thor.conf" <<'EOF'
g trusty - -
g crypto - -
g debug - -
EOF
  # Links resolve on the target system; in the build root they dangle, so check the link itself.
  test -L "$pkgdir/usr/lib/raytone-l4t/libnvidia-rmapi-tegra.so.595.78"
}
