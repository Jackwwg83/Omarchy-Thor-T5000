# Jetson AGX Thor: route the APE to the headphone jack once the APE card is there
# (raytone-thor-audio-route.service). sound.target would start with whichever card comes first.
ACTION=="add", SUBSYSTEM=="sound", KERNEL=="controlC*", ATTRS{id}=="APE", TAG+="systemd", ENV{SYSTEMD_WANTS}+="raytone-thor-audio-route.service"
