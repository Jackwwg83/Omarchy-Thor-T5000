# RaytoneOS: NVIDIA L4T R39.2.1 graphics userspace for Jetson AGX Thor: OpenGL, GLES, EGL, GLX and
# Vulkan implementations, the GBM allocator backend and L4T's egl-gbm platform library. Wayland
# clients use Arch's egl-wayland (explicit sync); Gate 0b ran both builds and both worked. This is
# the layout Gate 0b ran: glue libraries registered by absolute path, drivers found through
# /usr/lib/raytone-l4t, NVIDIA's allocator as Mesa libgbm's backend.
pkgname=raytone-thor-graphics
pkgver=39.2.1
pkgrel=1
pkgdesc='NVIDIA L4T R39.2.1 OpenGL, EGL, GBM and Vulkan drivers for Jetson AGX Thor'
arch=(aarch64)
url='https://developer.nvidia.com/embedded/jetson-linux'
license=(LicenseRef-NVIDIA-L4T)
depends=(raytone-thor-core libglvnd egl-wayland vulkan-icd-loader mesa)
provides=(opengl-driver vulkan-driver egl-gbm)
conflicts=(egl-gbm nvidia-utils nvidia-open-dkms)
options=(!strip !debug)

# BEGIN l4t sources
# L4T r39.2 debs, from manifests/ (scripts/pkgbuild_sources.py)
_l4t_debs=(nvidia-l4t-3d-core nvidia-l4t-gbm)
source=("nvidia-l4t-3d-core.deb::https://repo.download.nvidia.com/jetson/som/pool/main/n/nvidia-l4t-3d-core/nvidia-l4t-3d-core_39.2.1-20260806224157_arm64.deb"
        "nvidia-l4t-gbm.deb::https://repo.download.nvidia.com/jetson/som/pool/main/n/nvidia-l4t-gbm/nvidia-l4t-gbm_39.2.1-20260806224157_arm64.deb")
sha256sums=('77fcb6c2c11ed67403f8e7697aab9d6ef11a2acbde86dd38a062a8945d5d8631'
            'e84d118dcdab013b783f34416865c981a27fa669e91d054067e54ef3f724c6d1')
noextract=(nvidia-l4t-3d-core.deb nvidia-l4t-gbm.deb)
# END l4t sources
source+=(l4t_repack.py l4t_manifest.py)
sha256sums+=(SKIP SKIP)
# Only NVIDIA-named libraries enter the loader path (raytone-thor-core owns /usr/lib/raytone-l4t and
# its ld.so.conf.d entry); NVIDIA's ld.so.conf.d file for tegra-egl is dropped. The egl-gbm glue is
# loaded by absolute path and stays off the loader path.
_allow='^(libnv|libGLX_nvidia|libEGL_nvidia|libGLES(v1_CM|v2)_nvidia)'
_glue='^libnvidia-egl-(wayland|gbm)\.so'
_stage() { # unpack each deb's data.tar into its own tree
  local d
  for d in "${_l4t_debs[@]}"; do
    rm -rf "$srcdir/stage-$d" && mkdir -p "$srcdir/stage-$d"
    bsdtar -xOf "$srcdir/$d.deb" 'data.tar.*' | bsdtar -xpf - -C "$srcdir/stage-$d"
  done
}

_repack() { # _repack EXCLUDE_REGEX... : lay the trees out for Arch, report kept and dropped paths
  local args=() rx
  for rx in "$@"; do args+=(--exclude "$rx"); done
  python3 "$srcdir/l4t_repack.py" --out "$pkgdir" --pkgname "$pkgname" --report "$srcdir/$pkgname-report.json" \
    "${args[@]}" $(printf "$srcdir/stage-%s " "${_l4t_debs[@]}")
  install -Dm644 "$srcdir/$pkgname-report.json" "$pkgdir/usr/share/raytone/$pkgname-report.json"
}

package() {
  _stage
  _repack '^/etc/ld\.so\.conf\.d/' '^/usr/lib/xorg/' '^/usr/share/egl/egl_external_platform\.d/nvidia_gbm\.json$'
  local f b
  install -d "$pkgdir/usr/lib/raytone-l4t" "$pkgdir/usr/lib/gbm" "$pkgdir/usr/share/egl/egl_external_platform.d"
  for f in "$pkgdir"/usr/lib/aarch64-linux-gnu/nvidia/*.so* "$pkgdir"/usr/lib/aarch64-linux-gnu/tegra-egl/*.so*; do
    b=$(basename "$f")
    if [[ $b =~ $_allow && ! $b =~ $_glue ]]; then
      ln -s "${f#"$pkgdir"}" "$pkgdir/usr/lib/raytone-l4t/"
    fi
  done
  # Same name and order as Arch's egl-gbm, which this package replaces.
  printf '{"file_format_version":"1.0.0","ICD":{"library_path":"%s"}}\n' \
    /usr/lib/aarch64-linux-gnu/nvidia/libnvidia-egl-gbm.so.1 \
    > "$pkgdir/usr/share/egl/egl_external_platform.d/15_nvidia_gbm.json"
  # Mesa's libgbm looks for <drm driver>_gbm.so in its own backend directory.
  ln -s /usr/lib/aarch64-linux-gnu/nvidia/libnvidia-allocator.so.1 "$pkgdir/usr/lib/gbm/nvidia-drm_gbm.so"
  ln -s /usr/lib/aarch64-linux-gnu/nvidia/libnvidia-allocator.so.1 "$pkgdir/usr/lib/gbm/tegra_gbm.so"
  # Links resolve on the target system; in the build root they dangle, so check the links themselves.
  test -L "$pkgdir/usr/lib/raytone-l4t/libEGL_nvidia.so.0"
  test -L "$pkgdir/usr/lib/raytone-l4t/libGLX_nvidia.so.0"
  test -L "$pkgdir/usr/lib/raytone-l4t/libnvidia-allocator.so.1"
  test ! -L "$pkgdir/usr/lib/raytone-l4t/libnvidia-egl-gbm.so.1"
  test -f "$pkgdir/usr/share/glvnd/egl_vendor.d/10_nvidia.json"
  test -L "$pkgdir/etc/vulkan/icd.d/nvidia_icd.json"
}
