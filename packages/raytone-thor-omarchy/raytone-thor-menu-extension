#!/bin/bash
# Hide the Omarchy menu entries that cannot work on the Jetson AGX Thor. Omarchy's shell reads only
# its defaults and the user's ~/.config/omarchy/extensions/omarchy-menu.jsonc, where reusing an id
# overrides its fields; so this puts a marked block of {"when":"false"} overrides first in that file
# (replacing an earlier block), and the user's own entries, after it, still win.
#
# The list and the evidence for each entry (packages missing for aarch64, x86_64-only binaries,
# no DKMS headers, no suspend, no UKI boot, firmware capsules not allowed): docs/evidence/slice2/menu.md.
set -euo pipefail
file=${1:-$HOME/.config/omarchy/extensions/omarchy-menu.jsonc}
ids=(
  system.suspend
  install.service.dropbox install.service.spotify install.service.bitwarden
  install.browser.edge install.terminal.ghostty
  install.ai.lm-studio install.ai.grok-bot install.ai.t3-code install.ai.hermes
  install.gaming.steam install.gaming.minecraft install.gaming.heroic install.gaming.lutris
  install.gaming.battlenet install.gaming.geforce-now install.gaming.retroarch install.gaming.xbox-controllers
  setup.direct-boot update.password.drive style.unlock update.config.plymouth update.firmware
)
begin='  // BEGIN raytone-thor: entries that cannot work on Jetson AGX Thor (raytone-thor-menu-extension)'
end='  // END raytone-thor'

mkdir -p "$(dirname "$file")"
[[ -f $file ]] || printf '{\n}\n' > "$file"
grep -q '^[[:space:]]*{[[:space:]]*$' "$file" || { echo "raytone-thor-menu-extension: no opening { line in $file" >&2; exit 1; }
# Entries that work on the Thor with its own package instead of upstream's.
overrides=(
  '"install.ai.ollama": {"action":"omarchy-install-app Ollama raytone-thor-ollama"},'
  # the local model manager (raytone-models), where it is installed; SUPER + M below
  '"raytone-models": {"icon":"󰧑","label":"Raytone Models","description":"Local models, recipes, agents and video (SUPER + M)","when":"command -v raytone-models-app","action":"raytone-models-app"},'
)
block=$(printf '%s\n' "$begin"; printf '  "%s": {"when":"false"},\n' "${ids[@]}"; printf '  %s\n' "${overrides[@]}"
        printf '%s' "$end")
tmp=$(mktemp "$file.XXXXXX")
BLOCK=$block BEGIN_LINE=$begin END_LINE=$end awk '
  $0 == ENVIRON["BEGIN_LINE"] { skip = 1; next }
  skip && $0 == ENVIRON["END_LINE"] { skip = 0; next }
  skip { next }
  { print }
  !done && /^[[:space:]]*\{[[:space:]]*$/ { print ENVIRON["BLOCK"]; done = 1 }
  END { if (skip) exit 3 }
' "$file" > "$tmp" || {
  rm -f "$tmp"
  echo "raytone-thor-menu-extension: $file has the BEGIN marker without its END marker; not changed" >&2
  exit 1
}
cat "$tmp" > "$file"
rm -f "$tmp"
echo "Jetson AGX Thor: ${#ids[@]} menu entries hidden, ${#overrides[@]} pointed at Thor packages, in $file"

# SUPER + M opens Raytone Models: a marked block at the end of the user's Lua bindings, unless the
# user binds SUPER + M themselves (then theirs stays and ours goes). A marker without its partner
# leaves the file alone; the file is replaced whole (a link is followed), never cut in place.
# Hyprland reloads the file when it changes.
bindings=${2:-$HOME/.config/hypr/bindings.lua}
[[ -f $bindings ]] && python3 - "$bindings" <<'PY'
import os, re, sys, tempfile
path = sys.argv[1]
begin = "-- BEGIN raytone-thor: Raytone Models (raytone-thor-menu-extension)"
end = "-- END raytone-thor"
real = os.path.realpath(path)
text = open(real, encoding="utf-8").read()
lines = text.splitlines(keepends=True)
b = [i for i, l in enumerate(lines) if l.rstrip("\r\n") == begin]
e = [i for i, l in enumerate(lines) if l.rstrip("\r\n") == end]
if len(b) > 1 or len(e) != len(b) or (b and e[0] < b[0]):
    print(f"raytone-thor-menu-extension: {path} has a Raytone Models marker without its partner; not changed",
          file=sys.stderr)
    sys.exit(0)
if b:
    start = b[0] - 1 if b[0] > 0 and lines[b[0] - 1] == "\n" else b[0]   # the blank line we put before it
    others = lines[:start] + lines[e[0] + 1:]
else:
    others = lines
bound = re.compile(r"""\bbind\s*\(\s*(["'])SUPER\s*\+\s*M\1""")
# whole-line comments out, then the call may span lines (\s matches newlines)
users = bool(bound.search("".join(l for l in others if not l.lstrip().startswith("--"))))
if users:
    new = "".join(others)
elif b:
    new = text
else:
    new = text + ("" if text.endswith("\n") or not text else "\n") + \
          f'\n{begin}\no.bind("SUPER + M", "Raytone Models", "raytone-models-app")\n{end}\n'
if new != text:
    mode = os.stat(real).st_mode & 0o7777
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(real), prefix=".raytone-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(new)
    os.chmod(tmp, mode)
    os.replace(tmp, real)
    if not users:
        print(f"Raytone Models on SUPER + M in {path}")
PY
exit 0
