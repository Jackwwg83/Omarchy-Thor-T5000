#!/bin/bash
# Omarchy on the Thor's NVMe boots through JetPack's L4TLauncher, which loads the kernel from
# JetPack's APP partition (/boot/raytone-thor/Image and initrd, install-thor-nvme.sh boot-entry).
# After a raytone-thor-linux upgrade (and mkinitcpio's rebuild), copy both there. On the USB drive (no nvme-boot.conf) and
# anywhere else, nothing happens. Run by 95-raytone-thor-nvme-kernel.hook.
set -euo pipefail
conf=${RAYTONE_NVME_BOOT_CONF:-/etc/raytone/nvme-boot.conf}
modules=${RAYTONE_MODULES:-/usr/lib/modules}
mnt=${RAYTONE_APP_MOUNT:-/run/raytone-app}
[[ -f $conf ]] || exit 0
APP_PARTUUID='' KERNEL='' INITRD=''
# shellcheck source=/dev/null
source "$conf"
[[ $APP_PARTUUID =~ ^[0-9a-f-]{36}$ && $KERNEL == /boot/raytone-thor/* && $INITRD == /boot/raytone-thor/* ]] ||
  { echo "raytone: bad $conf" >&2; exit 1; }
initrd_src=${RAYTONE_INITRD_SRC:-/boot/initramfs-raytone-thor-linux.img}
[[ -f $initrd_src ]] || { echo "raytone: no $initrd_src" >&2; exit 1; }
src='' n=0
for k in "$modules"/*/pkgbase; do
  [[ -f $k && $(cat "$k") == raytone-thor-linux ]] && { src=$(dirname "$k")/vmlinuz; n=$((n + 1)); }
done
[[ $n == 1 && -f $src ]] || { echo "raytone: want one raytone-thor-linux kernel under $modules, found $n" >&2; exit 1; }
kver=$(basename "$(dirname "$src")")
# the initramfs must be this kernel's and able to reach the NVMe, or the default entry would not boot
list=$(mktemp)
lsinitcpio "$initrd_src" > "$list" || { rm -f "$list"; echo "raytone: cannot list $initrd_src" >&2; exit 1; }
for m in pcie-tegra264.ko phy-tegra194-p2u.ko nvme.ko nvme-core.ko; do
  grep -qE "^usr/lib/modules/$kver/.*/$m\$" "$list" ||
    { rm -f "$list"; echo "raytone: $initrd_src has no $m for $kver; APP keeps its kernel and initramfs" >&2; exit 1; }
done
rm -f "$list"
mkdir -p "$mnt"
mount -o noatime "/dev/disk/by-partuuid/$APP_PARTUUID" "$mnt"
trap 'rm -f "$mnt$KERNEL.new" "$mnt$INITRD.new"; umount "$mnt"' EXIT
[[ -d $mnt${KERNEL%/*} && ! -L $mnt${KERNEL%/*} ]] || { echo "raytone: APP has no ${KERNEL%/*} (not the port's layout)" >&2; exit 1; }
# both written in full before either is renamed: a failed copy leaves the old pair
install -m 0644 "$src" "$mnt$KERNEL.new"
install -m 0644 "$initrd_src" "$mnt$INITRD.new"
sync
mv -f "$mnt$KERNEL.new" "$mnt$KERNEL"
mv -f "$mnt$INITRD.new" "$mnt$INITRD"
sync
echo "raytone: kernel and initramfs copied to JetPack's APP $KERNEL, $INITRD (L4TLauncher's omarchy entry)"
