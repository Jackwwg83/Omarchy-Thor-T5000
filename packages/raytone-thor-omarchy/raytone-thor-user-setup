#!/bin/bash
# Bring the Thor layer's per-user parts to every existing Omarchy user (a home with
# ~/.config/omarchy): the pre-refresh-pacman hook and the menu's hidden entries. /etc/skel only
# reaches users created later. Run as root by raytone-thor-omarchy.install on install and upgrade;
# everything in a home is done as its owner.
set -uo pipefail
homes=${RAYTONE_HOMES:-/home}
skel=${RAYTONE_SKEL:-/etc/skel}
hook=.config/omarchy/hooks/pre-refresh-pacman.d/10-raytone-thor
for home in "$homes"/*; do
  [[ -d $home/.config/omarchy && ! -L $home ]] || continue
  user=$(ls -ld "$home" | awk '{print $3}')
  { runuser -u "$user" -- mkdir -p "$(dirname "$home/$hook")" &&
    runuser -u "$user" -- install -m 0644 "$skel/$hook" "$home/$hook"; } ||
    echo "raytone-thor-user-setup: could not install the pacman hook for $user" >&2
  runuser -u "$user" -- env HOME="$home" raytone-thor-menu-extension > /dev/null ||
    echo "raytone-thor-user-setup: menu entries not hidden for $user (see above)" >&2
done
exit 0
