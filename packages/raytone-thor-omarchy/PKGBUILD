# RaytoneOS: the Jetson AGX Thor layer for upstream Omarchy. No upstream file is patched: this
# package adds files next to Omarchy's and runs Omarchy's own installer with three reviewed
# overrides (see raytone-omarchy-apply-system and overrides/UPSTREAM.sha256).
pkgname=raytone-thor-omarchy
pkgver=0.1.0
pkgrel=1
pkgdesc='Jetson AGX Thor layer for Omarchy: display device, pacman repositories, install overrides'
arch=(any)
url='https://github.com/Jackwwg83/Omarchy-Thor-T5000'
license=(MIT)
depends=(omarchy raytone-thor-graphics hyprland sddm uwsm)
backup=(etc/sddm.conf.d/20-raytone-thor.conf)
source=(raytone-omarchy-apply-system
        overrides/UPSTREAM.sha256
        overrides/install/config/snapper.sh
        overrides/install/hardware/nvidia.sh
        overrides/install/post-install/pacman.sh
        pacman/pacman.conf
        pacman/mirrorlist
        uwsm-env.d-20-raytone-thor
        sddm-20-raytone-thor.conf)
sha256sums=(SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP)

package() {
  local o=$pkgdir/usr/share/raytone-thor/omarchy-overrides
  install -Dm755 "$srcdir/raytone-omarchy-apply-system" "$pkgdir/usr/bin/raytone-omarchy-apply-system"
  install -Dm644 "$srcdir/UPSTREAM.sha256" "$o/UPSTREAM.sha256"
  install -Dm644 "$srcdir/snapper.sh" "$o/install/config/snapper.sh"
  install -Dm644 "$srcdir/nvidia.sh" "$o/install/hardware/nvidia.sh"
  install -Dm644 "$srcdir/pacman.sh" "$o/install/post-install/pacman.sh"
  install -Dm644 "$srcdir/pacman.conf" "$pkgdir/usr/share/raytone-thor/pacman/pacman.conf"
  install -Dm644 "$srcdir/mirrorlist" "$pkgdir/usr/share/raytone-thor/pacman/mirrorlist"
  install -Dm644 "$srcdir/uwsm-env.d-20-raytone-thor" "$pkgdir/usr/share/uwsm/env.d/20-raytone-thor"
  install -Dm644 "$srcdir/sddm-20-raytone-thor.conf" "$pkgdir/etc/sddm.conf.d/20-raytone-thor.conf"
}
