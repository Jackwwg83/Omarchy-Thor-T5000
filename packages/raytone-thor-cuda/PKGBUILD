source+=(l4t_repack.py l4t_manifest.py)
sha256sums+=(SKIP SKIP)

_stage() { # unpack each deb's data.tar into its own tree
  local d
  for d in "${_l4t_debs[@]}"; do
    rm -rf "$srcdir/stage-$d" && mkdir -p "$srcdir/stage-$d"
    bsdtar -xOf "$srcdir/$d.deb" 'data.tar.*' | bsdtar -xpf - -C "$srcdir/stage-$d"
  done
}

_repack() { # _repack EXCLUDE_REGEX... : lay the trees out for Arch, report kept and dropped paths
  local args=() rx
  for rx in "$@"; do args+=(--exclude "$rx"); done
  python3 "$srcdir/l4t_repack.py" --out "$pkgdir" --pkgname "$pkgname" --report "$srcdir/$pkgname-report.json" \
    "${args[@]}" $(printf "$srcdir/stage-%s " "${_l4t_debs[@]}")
  install -Dm644 "$srcdir/$pkgname-report.json" "$pkgdir/usr/share/raytone/$pkgname-report.json"
}

# What the debs' postinst does with update-alternatives, and the environment for nvcc.
_cuda_layout() {
  install -d "$pkgdir/usr/local" "$pkgdir/etc/profile.d"
  ln -sfn cuda-13.2 "$pkgdir/usr/local/cuda"
  ln -sfn cuda-13.2 "$pkgdir/usr/local/cuda-13"
  printf '%s\n' \
    '# CUDA 13.2 (raytone-thor-cuda): nvcc on PATH; gcc 16 as host compiler, in C++17 mode.' \
    'export PATH="$PATH:/usr/local/cuda/bin"' \
    'export NVCC_PREPEND_FLAGS="-allow-unsupported-compiler -std=c++17"' \
    > "$pkgdir/etc/profile.d/raytone-cuda.sh"
}

package() {
  _stage
  _repack '/libcublas(Lt)?_static\.a$'
  _cuda_layout
  test -x "$pkgdir/usr/local/cuda-13.2/bin/nvcc"
  test -f "$pkgdir/etc/ld.so.conf.d/000_cuda.conf"
}
