# RaytoneOS: CUDA 13.2 for Jetson AGX Thor, NVIDIA's arm64 debs from the Jetson repository's common
# component (r39.2), byte-identical in content to its SBSA CUDA repository, repackaged unmodified and
# laid out as Ubuntu installs them (/usr/local/cuda-13.2, the /usr/local/cuda and cuda-13 links the
# config-common debs' update-alternatives create, their ld.so.conf.d entries). The minimal set for
# nvcc, the runtime and cuBLAS; cuBLAS's static archives (962 MiB) are left out.
#
# Host compiler: Arch's gcc 16, which CUDA 13.2 does not list. nvcc takes it with
# -allow-unsupported-compiler and -std=c++17 (gcc 16 defaults to C++20, whose libstdc++ headers
# nvcc's front end rejects), set through NVCC_PREPEND_FLAGS in /etc/profile.d. The driver side
# (libcuda) comes from raytone-thor-core. Pins: manifests/cuda-13.2.json.
pkgname=raytone-thor-cuda
pkgver=13.2.86
pkgrel=1
pkgdesc='NVIDIA CUDA 13.2 toolkit (nvcc, runtime, cuBLAS) for Jetson AGX Thor'
arch=(aarch64)
url='https://developer.nvidia.com/cuda-toolkit'
license=(LicenseRef-NVIDIA-CUDA)
depends=(raytone-thor-core gcc)
provides=("cuda=$pkgver")
conflicts=(cuda)
options=(!strip !debug staticlibs)

# BEGIN l4t sources
# CUDA 13.2 debs (jetson/common r39.2), from manifests/ (scripts/pkgbuild_sources.py)
