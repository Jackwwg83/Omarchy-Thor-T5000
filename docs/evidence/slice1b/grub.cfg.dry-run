# Generated by thor_boot.py; RaytoneOS Omarchy Thor USB boot menu.
set timeout=3
set default="jetpack-nvme"
set fallback="5"
if [ -s $prefix/grubenv ]; then
  load_env -f $prefix/grubenv next_entry
fi
if [ -n "${next_entry}" ]; then
  set try_entry="${next_entry}"
  set next_entry=
  if save_env -f $prefix/grubenv next_entry; then
    set default="${try_entry}"
  fi
fi

menuentry "JetPack on the internal NVMe (its own boot loader)" --id jetpack-nvme {
  if search --no-floppy --fs-uuid --set=root 2BBE-D8EC; then
    chainloader /EFI/BOOT/BOOTAA64.efi
    boot
  fi
  echo "RaytoneOS: could not boot jetpack-nvme; rebooting in 10 seconds"
  sleep 10
  reboot
}

menuentry "Slice 1a test: JetPack kernel and root through GRUB" --id jetpack-grub {
  if search --no-floppy --fs-uuid --set=root 51cac00d-1733-4097-a9dc-82f35a4a1c8f; then
    linux /boot/Image root=PARTUUID=1b3479b0-b4c2-4a1b-8b81-86d864b3944e rw rootwait rootfstype=ext4 mminit_loglevel=4 earlycon=tegra_utc,mmio32,0xc5a0000 console=ttyUTC0,115200 firmware_class.path=/etc/firmware fbcon=map:0 efi=runtime audit=1 audit_backlog_limit=8192 swiotlb=2048 video=efifb:off console=tty0 panic=10
    initrd /boot/initrd
    boot
  fi
  echo "RaytoneOS: could not boot jetpack-grub; rebooting in 10 seconds"
  sleep 10
  reboot
}

menuentry "Slice 1b test: RaytoneOS (Arch Linux ARM) from the USB drive" --id raytone-arch {
  if search --no-floppy --fs-uuid --set=root 4ae3be9c-9ec7-4507-b6ac-33c46734dfa5; then
    linux /boot/vmlinuz-raytone-thor-linux root=PARTUUID=ca5a56c6-4a4b-4e02-8183-ff166514ae3b rw rootwait=20 rootfstype=ext4 mminit_loglevel=4 earlycon=tegra_utc,mmio32,0xc5a0000 console=ttyUTC0,115200 firmware_class.path=/etc/firmware fbcon=map:0 efi=runtime audit=1 audit_backlog_limit=8192 swiotlb=2048 video=efifb:off console=tty0 panic=10
    boot
  fi
  echo "RaytoneOS: could not boot raytone-arch; rebooting in 10 seconds"
  sleep 10
  reboot
}

menuentry "Slice 1b fallback: RaytoneOS with its initramfs" --id raytone-arch-initramfs {
  if search --no-floppy --fs-uuid --set=root 4ae3be9c-9ec7-4507-b6ac-33c46734dfa5; then
    linux /boot/vmlinuz-raytone-thor-linux root=PARTUUID=ca5a56c6-4a4b-4e02-8183-ff166514ae3b rw rootwait=20 rootfstype=ext4 mminit_loglevel=4 earlycon=tegra_utc,mmio32,0xc5a0000 console=ttyUTC0,115200 firmware_class.path=/etc/firmware fbcon=map:0 efi=runtime audit=1 audit_backlog_limit=8192 swiotlb=2048 video=efifb:off console=tty0 panic=10
    initrd /boot/initramfs-raytone-thor-linux.img
    boot
  fi
  echo "RaytoneOS: could not boot raytone-arch-initramfs; rebooting in 10 seconds"
  sleep 10
  reboot
}

menuentry "Slice 1b A/B: RaytoneOS root with the JetPack kernel (vendor build, read from NVMe)" --id raytone-arch-jetpack-kernel {
  if search --no-floppy --fs-uuid --set=root 51cac00d-1733-4097-a9dc-82f35a4a1c8f; then
    linux /boot/Image root=PARTUUID=ca5a56c6-4a4b-4e02-8183-ff166514ae3b rw rootwait=20 rootfstype=ext4 mminit_loglevel=4 earlycon=tegra_utc,mmio32,0xc5a0000 console=ttyUTC0,115200 firmware_class.path=/etc/firmware fbcon=map:0 efi=runtime audit=1 audit_backlog_limit=8192 swiotlb=2048 video=efifb:off console=tty0 panic=10
    boot
  fi
  echo "RaytoneOS: could not boot raytone-arch-jetpack-kernel; rebooting in 10 seconds"
  sleep 10
  reboot
}

menuentry "Reboot and try again" --id retry-reboot {
  echo "RaytoneOS: rebooting in 10 seconds"
  sleep 10
  reboot
}

menuentry "UEFI boot manager (for a person at the keyboard)" --id uefi-menu {
  exit
}
